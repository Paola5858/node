# A aplicação usa a API local em /api; o Vite a encaminha à porta 3001.
# Em produção, configure a URL pública da API, incluindo /api se necessário.
VITE_API_URL=/api
API_PORT=3001
DATABASE_PATH=data/plume.sqlite

# Link de incorporação usado ao criar uma organização; não é uma credencial.
# O relatório ainda aplica as próprias permissões da Microsoft Power BI.
POWERBI_DEFAULT_EMBED_URL=https://app.powerbi.com/reportEmbed?reportId=22450b7a-e0c7-4472-a33a-becc7adaa99e&autoAuth=true&ctid=b1051c4b-3b94-41ab-9441-e73a72342fdd
