# Configurações do Cana Intelligence
# A aplicação usa a API local em /api; o Vite a encaminha à porta 3001 em desenvolvimento.
# Em produção, configure a URL pública da API, incluindo /api se necessário.
VITE_API_URL=/api
API_PORT=3001
APP_ENV=DEV
DATABASE_URL_DEV=postgresql://cana_dev:cana_dev@localhost:5432/cana_dev
DATABASE_URL_QAS=postgresql://cana_qas:cana_qas@localhost:5432/cana_qas
# Configure DATABASE_URL_PRD somente no ambiente de produção e habilite a conexão de forma explícita.
# ALLOW_PRD_DATABASE=true
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# S3/MinIO compatível. Deixe endpoint vazio para AWS S3.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=cana-originals-dev
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Link público do Power BI usado como dashboard inicial de novas organizações.
# Qualquer pessoa com este link pode visualizar o relatório.
POWERBI_DEFAULT_EMBED_URL=https://app.powerbi.com/view?r=eyJrIjoiYzBjZTIzNDQtNjcxNi00NmEwLTg1NzQtMDQ3YWE3M2ZkZDEwIiwidCI6ImIxMDUxYzRiLTNiOTQtNDFhYi05NDQxLWU3M2E3MjM0MmZkZCJ9
