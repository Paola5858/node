# Configurações do Cana Intelligence (Plume)
# A aplicação usa a API local em /api; o Vite a encaminha à porta 3001 em desenvolvimento.
# Em produção, configure a URL pública da API, incluindo /api se necessário.
VITE_API_URL=/api
API_PORT=3001
DATABASE_PATH=data/plume.sqlite

# Link público do Power BI usado como dashboard inicial de novas organizações.
# Qualquer pessoa com este link pode visualizar o relatório.
POWERBI_DEFAULT_EMBED_URL=https://app.powerbi.com/view?r=eyJrIjoiYzBjZTIzNDQtNjcxNi00NmEwLTg1NzQtMDQ3YWE3M2ZkZDEwIiwidCI6ImIxMDUxYzRiLTNiOTQtNDFhYi05NDQxLWU3M2E3MjM0MmZkZCJ9
