# Configurações do Cana Intelligence (Plume)
# A aplicação usa a API local em /api; o Vite a encaminha à porta 3001 em desenvolvimento.
# Em produção, configure a URL pública da API, incluindo /api se necessário.
VITE_API_URL=/api
API_PORT=3001
DATABASE_PATH=data/plume.sqlite

# Link de incorporação oficial do Power BI utilizado ao criar novas organizações.
# Report ID: 022d42c1-d543-4a0d-9bd8-f3ac742a7ff1 | Tenant ID: b1051c4b-3b94-41ab-9441-e73a72342fdd
# O relatório aplica suas próprias permissões e autenticação do Microsoft Power BI.
POWERBI_DEFAULT_EMBED_URL=https://app.powerbi.com/reportEmbed?reportId=022d42c1-d543-4a0d-9bd8-f3ac742a7ff1&autoAuth=true&ctid=b1051c4b-3b94-41ab-9441-e73a72342fdd
